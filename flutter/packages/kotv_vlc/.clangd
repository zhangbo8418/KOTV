# Flutter 插件本机未生成 ephemeral 头时，clangd 会对 flutter/*.h 报红并连锁污染整文件。
# 真实编译走 CMake（flutter build），不依赖本配置。
CompileFlags:
  Add:
    - -Icommon
    - -Iwindows
    - -Iwindows/include
    - -Imacos/Classes
    - -std=c++17
    - -x
    - c++
Diagnostics:
  Suppress:
    - pp_file_not_found
    - pp_including_mainfile_in_toplevel

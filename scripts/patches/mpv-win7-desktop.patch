 #include <windows.h>
 #include <knownfolders.h>
+#if _WIN32_WINNT >= _WIN32_WINNT_WIN8
 #include <pathcch.h>
+#endif
 #include <shlobj.h>
 #include <shlwapi.h>
 
@@ -205,8 +207,23 @@
     LPWSTR shortcut_path = NULL;
     LPWSTR programs_path = NULL;
     if (SUCCEEDED(SHGetKnownFolderPath(&FOLDERID_Programs, 0, NULL, &programs_path))) {
+#if _WIN32_WINNT >= _WIN32_WINNT_WIN8
         PathAllocCombine(programs_path, MPV_NAME L".lnk",
                          PATHCCH_ALLOW_LONG_PATHS, &shortcut_path);
+#else
+        {
+            const wchar_t *leaf = MPV_NAME L".lnk";
+            size_t need = wcslen(programs_path) + wcslen(leaf) + 2;
+            shortcut_path = CoTaskMemAlloc(need * sizeof(wchar_t));
+            if (shortcut_path) {
+                int n = _snwprintf(shortcut_path, need, L"%s\%s", programs_path, leaf);
+                if (n < 0 || (size_t)n >= need) {
+                    CoTaskMemFree(shortcut_path);
+                    shortcut_path = NULL;
+                }
+            }
+        }
+#endif
     } else {
         mp_msg(log, MSGL_ERR, "Failed to get Programs folder path.\n");
     }

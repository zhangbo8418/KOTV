# 群晖 Toolkit 运行时版本钉（CI cache 随本文件变化失效）
# shellcheck shell=bash

SYNO_DSM_VER="7.2"
# Toolkit GCC 12.2：Node ≥26 要 g++≥13.2 → 钉 Node 22 LTS
SYNO_NODE_VER="v22.23.5"
# CPython 3.14；交叉编时 --with-build-python 的 major.minor 必须与目标一致
SYNO_PYTHON_VER="3.14.7"
SYNO_JDK_FEATURE="21"
SYNO_CHROMIUM_TAG="${SYNO_CHROMIUM_TAG:-latest}"
SYNO_CHROMIUM_COMMIT="${SYNO_CHROMIUM_COMMIT:-}"
SYNO_FFMPEG_VER="6.1.1"

# ---------- Toolkit 自编 deps（目标链接禁止宿主 /usr）----------
# Node：openssl/zlib/brotli/c-ares/nghttp2；ICU 仍用 Node 树内 full-icu
# Python：CPython optional modules
# JRE：OpenJDK building.md 必选 alsa/cups/fontconfig/X11
# ffmpeg：zlib + openssl
SYNO_ZLIB_VER="1.3.1"
SYNO_BZIP2_VER="1.0.8"
SYNO_XZ_VER="5.6.4"
SYNO_ZSTD_VER="1.5.6"
SYNO_LIBFFI_VER="3.4.8"
SYNO_OPENSSL_VER="3.3.5"
SYNO_BROTLI_VER="1.1.0"
SYNO_CARES_VER="1.34.4"
SYNO_NGHTTP2_VER="1.64.0"
SYNO_SQLITE_VER="3460100"
SYNO_SQLITE_YEAR="2024"
SYNO_NCURSES_VER="6.5"
SYNO_READLINE_VER="8.2"
SYNO_UTIL_LINUX_VER="2.40.2"
SYNO_EXPAT_VER="2.6.4"
SYNO_FREETYPE_VER="2.13.3"
SYNO_FONTCONFIG_VER="2.15.0"
SYNO_CUPS_VER="2.4.11"
SYNO_ALSA_VER="1.2.14"
# Chromium：Toolkit sysroot ABI + 自编补齐 GN pkg-config 必查包（dri/xkbcommon/libdrm）
SYNO_LIBDRM_VER="2.4.124"
SYNO_LIBXKBCOMMON_VER="1.7.0"
SYNO_MESA_VER="24.2.8"
# X11：JRE 始终编进 deps（完整头文件闭包）
SYNO_XORGPROTO_VER="2024.1"
SYNO_LIBXAU_VER="1.0.11"
SYNO_XCB_PROTO_VER="1.17.0"
SYNO_LIBXCB_VER="1.17.0"
SYNO_LIBX11_VER="1.8.10"
SYNO_LIBXEXT_VER="1.3.6"
SYNO_LIBXRENDER_VER="0.9.11"
SYNO_LIBXRANDR_VER="1.5.4"
SYNO_LIBXTST_VER="1.2.5"
SYNO_LIBXI_VER="1.8.2"
SYNO_LIBICE_VER="1.1.1"
SYNO_LIBSM_VER="1.2.4"
SYNO_LIBXT_VER="1.3.0"

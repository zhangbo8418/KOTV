# 群晖工具链运行时版本钉（与 prepare-runtime 主版本对齐，可缓存）
# shellcheck shell=bash

SYNO_DSM_VER="7.2"
SYNO_NODE_VER="v26.13.0"
SYNO_PYTHON_VER="3.14.7"
SYNO_JDK_FEATURE="21"
# Chromium：默认解析「最新」——优先 Chrome for Testing Stable，其次 chromium src 远端 HEAD。
# 仅当显式设置 SYNO_CHROMIUM_TAG / SYNO_CHROMIUM_COMMIT / 环境变量同名时才钉死。
SYNO_CHROMIUM_TAG="${SYNO_CHROMIUM_TAG:-latest}"
SYNO_CHROMIUM_COMMIT="${SYNO_CHROMIUM_COMMIT:-}"

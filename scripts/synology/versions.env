# 群晖 Toolkit 运行时版本钉（同主系列便于与 prepare-runtime / CI cache 共用）
# shellcheck shell=bash

SYNO_DSM_VER="7.2"
# Toolkit GCC 12.2：Node ≥26 要 g++≥13.2；钉 Node 22 LTS。
SYNO_NODE_VER="v22.23.5"
# 与桌面 prepare-runtime 同系；交叉编时 --with-build-python 须与宿主 major.minor 一致（CI 宿主常为 3.14）。
SYNO_PYTHON_VER="3.14.7"
# Toolkit 自编 deps（不用宿主 / 不用 sysroot 里损坏的布局）
SYNO_LIBFFI_VER="3.4.8"
SYNO_ALSA_VER="1.2.14"
SYNO_JDK_FEATURE="21"
# Chromium：默认解析 CFT Stable 最新；可用 SYNO_CHROMIUM_TAG / SYNO_CHROMIUM_COMMIT 钉死。
SYNO_CHROMIUM_TAG="${SYNO_CHROMIUM_TAG:-latest}"
SYNO_CHROMIUM_COMMIT="${SYNO_CHROMIUM_COMMIT:-}"

# KOTV

# Build / local binaries
bin/
/KOTV
/KO影视
*.exe
*.test
*.dmg
fail
.gocache/

# OS / editor junk
.DS_Store
.tmp-*.png
.tmp-*.jpg
*.swp
*~
__pycache__/
*.pyc

# Bridge build artifacts
bridge/build/
bridge/spider-bridge.jar
.gradle/
bridge/.gradle-bootstrap/
!bridge/gradle/wrapper/gradle-wrapper.jar

# Bundled runtimes & packages (download via scripts)
# 仅忽略仓库根目录 runtime/，勿匹配 internal/runtime 源码包
.runtime-cache/
/runtime/
/dist/

# Windows resource embedding
rsrc_windows_*.syso

# Generated QuickJS headers for spider ModuleLoader CGO
internal/spider/qjsinc/

# Android arm64 Go engine (built by scripts/build-engine-flutter.sh android)
flutter/android/app/src/main/jniLibs/**/*.so
flutter/assets/engine/libkotv_engine.so
# 引擎二进制按平台打包时生成，勿入库（否则 Win 会打进 mac/linux 的 kotv-engine）
flutter/assets/engine/kotv-engine
flutter/assets/engine/kotv-engine.exe

# 开源内嵌字体（仅 Win7 线 ~28MB，KOTV_WIN7=1 + fetch-flutter-fonts.sh）
flutter/assets/fonts/*.otf
flutter/assets/fonts/*.ttf
flutter/assets/fonts/LICENSE*

